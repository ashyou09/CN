# phase2/personC/firewall/local_single_mac_test.pf
# 1-Mac loopback service isolation test (surgical on port 3001 only)

# Allow simulated Edge alias (127.0.0.2) to reach Backend A (127.0.0.1:3001)
pass in quick on lo0 proto tcp from 127.0.0.2 to 127.0.0.1 port 3001

# Block simulated Client alias (127.0.0.3) from directly reaching Backend A (127.0.0.1:3001)
block return-rst in quick on lo0 proto tcp from 127.0.0.3 to 127.0.0.1 port 3001
